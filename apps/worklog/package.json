{
  "name": "worklog",
  "version": "0.1.0",
  "private": true,
  "description": "Log one line per task; get your standup, weekly summary and appraisal notes written for you.",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
