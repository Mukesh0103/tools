# ─── Required ────────────────────────────────────────────────────────────────
# Postgres connection string. Local: `pnpm db:up` starts one that matches this.
# Neon: use the *pooled* connection string.
DATABASE_URL=postgres://worklog:worklog@localhost:5432/worklog

# Auth.js secret. Generate with: openssl rand -base64 33
AUTH_SECRET=

# Public URL of the app (used for absolute URLs in link previews).
APP_URL=http://localhost:3000

# ─── Sign-in providers (each is enabled only when its keys are set) ─────────
# GitHub OAuth app: callback URL = {APP_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google OAuth client: callback URL = {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email sign-in (magic links), via Resend. Optional.
# Without a key in development, magic links are printed to the server console.
# Without a key in production, email sign-in is hidden.
RESEND_API_KEY=
EMAIL_FROM="Worklog <worklog@your-domain.com>"

# ─── AI summaries for imported pull requests (optional) ─────────────────────
# With a key, Claude turns each imported pull request into a one-line entry.
# Without one, the pull request title is used. GitHub and Jira import works either way.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# ─── Hourly sync cron ────────────────────────────────────────────────────────
# Shared secret the scheduler sends as `Authorization: Bearer <CRON_SECRET>` to
# /api/cron/sync (GitHub and Jira import).
CRON_SECRET=

# ─── Monitoring (optional) ───────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Testing only — never set these in a real deployment ─────────────────────
# Enables a password-less "test login" provider used by Playwright.
AUTH_TEST_LOGIN_SECRET=
