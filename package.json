{
  "name": "tools",
  "private": true,
  "description": "Monorepo for small personal productivity tools.",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.5"
  }
}
